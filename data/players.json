async function fetchData() {
  try {
    const [playersRes, fixturesRes] = await Promise.all([
      fetch("data/players.json"),
      fetch("data/fixtures.json")
    ]);

    if (!playersRes.ok || !fixturesRes.ok) {
      throw new Error("Missing dataset");
    }

    const players = await playersRes.json();
    const fixtures = await fixturesRes.json();

    return { players, fixtures, updatedAt: new Date().toISOString() };
  } catch (error) {
    return loadFallbackData();
  }
}

function formatMoney(value) {
  return `£${value.toFixed(1)}`;
}

function formatDifficulty(level) {
  const labels = {
    1: "Easy",
    2: "Fair",
    3: "Medium",
    4: "Hard",
    5: "Very hard"
  };
  return labels[level] || "Medium";
}

function getDiffClass(level) {
  return `diff-${level}`;
}

function loadSavedTeam() {
  try {
    const raw = localStorage.getItem("fpl-team");
    return raw ? JSON.parse(raw) : [];
  } catch (error) {
    return [];
  }
}

function saveTeam() {
  localStorage.setItem("fpl-team", JSON.stringify(state.selected));
}

function computeBudget() {
  const used = state.selected.reduce((sum, playerId) => {
    const player = state.players.find((entry) => entry.id === playerId);
    return sum + (player ? player.cost : 0);
  }, 0);

  return 100 - used;
}

function filterPlayers() {
  return state.players.filter((player) => {
    const matchesPosition = state.position === "all" || player.position === state.position;
    const matchesSearch = !state.searchTerm || player.name.toLowerCase().includes(state.searchTerm.toLowerCase());
    return matchesPosition && matchesSearch;
  });
}

function togglePlayer(playerId) {
  const selected = [...state.selected];
  const player = state.players.find((entry) => entry.id === playerId);
  if (!player) return;

  const exists = selected.includes(playerId);
  if (exists) {
    state.selected = selected.filter((id) => id !== playerId);
  } else {
    if (state.selected.length >= 15) return;
    const currentCost = state.selected.reduce((sum, id) => {
      const p = state.players.find((entry) => entry.id === id);
      return sum + (p ? p.cost : 0);
    }, 0);

    if (currentCost + player.cost > 100) return;
    state.selected = [...selected, playerId];
  }

  saveTeam();
  render();
}

function resetTeam() {
  state.selected = [];
  saveTeam();
  render();
}

function renderPlayerTable() {
  const filtered = filterPlayers();
  els.playerTableBody.innerHTML = filtered
    .map((player) => {
      const isSelected = state.selected.includes(player.id);
      return `
        <tr>
          <td>
            <div class="player-name">
              <strong>${player.name}</strong>
              <span>${player.team}</span>
            </div>
          </td>
          <td><span class="badge">${player.position}</span></td>
          <td>${formatMoney(player.cost)}</td>
          <td>${player.points}</td>
          <td>${player.xP.toFixed(2)}</td>
          <td>${player.form.toFixed(1)}</td>
          <td>${player.team}</td>
          <td>
            <button class="action-button" data-player-id="${player.id}">
              ${isSelected ? "Remove" : "Add"}
            </button>
          </td>
        </tr>
      `;
    })
    .join("");

  document.querySelectorAll(".action-button").forEach((button) => {
    button.addEventListener("click", () => {
      togglePlayer(Number(button.dataset.playerId));
    });
  });
}

function renderTeamBuilder() {
  const selectedPlayers = state.selected
    .map((id) => state.players.find((player) => player.id === id))
    .filter(Boolean);

  els.selectedCount.textContent = `${selectedPlayers.length}/15`;
  els.budgetValue.textContent = formatMoney(computeBudget());

  if (!selectedPlayers.length) {
    els.teamBuilderList.innerHTML = `<div class="team-row"><div class="team-player"><strong>No players selected</strong><span>Start building your squad</span></div></div>`;
    return;
  }

  els.teamBuilderList.innerHTML = selectedPlayers
    .map((player) => `
      <div class="team-row">
        <div class="team-player">
          <strong>${player.name}</strong>
          <span>${player.position} • ${player.team}</span>
        </div>
        <button class="ghost-button" data-remove-id="${player.id}">Remove</button>
      </div>
    `)
    .join("");

  document.querySelectorAll("[data-remove-id]").forEach((button) => {
    button.addEventListener("click", () => {
      togglePlayer(Number(button.dataset.removeId));
    });
  });
}

function renderFixtures() {
  els.fixtureList.innerHTML = state.fixtures
    .slice(0, 8)
    .map(
      (item) => `
        <div class="fixture-item">
          <div class="fixture-meta">
            <strong>${item.team}</strong>
            <span>Next: ${item.next}</span>
          </div>
          <span class="difficulty-pill ${getDiffClass(item.difficulty)}">${formatDifficulty(item.difficulty)}</span>
        </div>
      `
    )
    .join("");
}

function renderXpModel() {
  const ranked = [...state.players]
    .sort((a, b) => b.xP - a.xP)
    .slice(0, 5);

  els.avgXpValue.textContent = (state.players.reduce((sum, p) => sum + p.xP, 0) / Math.max(1, state.players.length)).toFixed(2);
  const bestPlayer = ranked[0];
  els.bestPickValue.textContent = bestPlayer ? bestPlayer.name : "—";

  els.xpList.innerHTML = ranked
    .map(
      (player) => `
        <div class="xp-item">
          <div class="xp-meta">
            <strong>${player.name}</strong>
            <span>${player.position} • ${player.team}</span>
          </div>
          <span class="xp-score">${player.xP.toFixed(2)} xP</span>
        </div>
      `
    )
    .join("");
}

function renderSummary() {
  const totalPlayers = state.players.length;
  els.totalPlayers.textContent = totalPlayers;

  const bestValuePlayer = [...state.players].sort((a, b) => {
    const valueA = a.points / a.cost;
    const valueB = b.points / b.cost;
    return valueB - valueA;
  })[0];

  els.bestValue.textContent = bestValuePlayer ? `${bestValuePlayer.name}` : "—";

  const highestXp = [...state.players].sort((a, b) => b.xP - a.xP)[0];
  els.highXp.textContent = highestXp ? `${highestXp.name} ${highestXp.xP.toFixed(2)}` : "—";
}

function render() {
  renderSummary();
  renderFixtures();
  renderPlayerTable();
  renderTeamBuilder();
  renderXpModel();
}

async function init() {
  const dataset = await fetchData();
  state.players = dataset.players;
  state.fixtures = dataset.fixtures;
  state.selected = loadSavedTeam();

  const firstUpdated = new Date(dataset.updatedAt);
  els.lastUpdate.textContent = firstUpdated.toLocaleString([], {
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit"
  });

  els.positionFilter.addEventListener("change", (event) => {
    state.position = event.target.value;
    renderPlayerTable();
  });

  els.searchInput.addEventListener("input", (event) => {
    state.searchTerm = event.target.value.trim();
    renderPlayerTable();
  });

  els.resetTeamButton.addEventListener("click", resetTeam);

  render();
}

init();
