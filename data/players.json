const state = {
  players: [],
  fixtures: [],
  selected: [],
  searchTerm: "",
  position: "all"
};

const els = {
  gameweekValue: document.querySelector("#gameweekValue"),
  avgXpValue: document.querySelector("#avgXpValue"),
  bestPickValue: document.querySelector("#bestPickValue"),
  totalPlayers: document.querySelector("#totalPlayers"),
  bestValue: document.querySelector("#bestValue"),
  highXp: document.querySelector("#highXp"),
  lastUpdate: document.querySelector("#lastUpdate"),
  playerTableBody: document.querySelector("#playerTableBody"),
  teamBuilderList: document.querySelector("#teamBuilderList"),
  selectedCount: document.querySelector("#selectedCount"),
  budgetValue: document.querySelector("#budgetValue"),
  fixtureList: document.querySelector("#fixtureList"),
  xpList: document.querySelector("#xpList"),
  positionFilter: document.querySelector("#positionFilter"),
  searchInput: document.querySelector("#searchInput"),
  resetTeamButton: document.querySelector("#resetTeamButton")
};

